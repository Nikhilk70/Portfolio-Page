rules_version = '2';

// TEMPORARY SEEDING RULES — use only while running `npm run seed:firebase`, then switch back to firestore.rules.
// Writes to content collections are allowed until the date below, after which they lock automatically.
// Update the date to a few days ahead each time you need to re-seed.
service cloud.firestore {
  match /databases/{database}/documents {

    match /{col}/{docId} {
      allow read: if col in ['site', 'skills', 'services', 'experience', 'projects', 'education', 'certificates'];
      allow write: if col in ['site', 'skills', 'services', 'experience', 'projects', 'education', 'certificates']
        && request.time < timestamp.date(2026, 10, 9);
    }

    match /messages/{msgId} {
      allow read, update, delete: if false;
      allow create: if request.resource.data.keys().hasOnly(['name', 'email', 'subject', 'message', 'source', 'createdAt'])
        && request.resource.data.name is string && request.resource.data.name.size() >= 2 && request.resource.data.name.size() <= 100
        && request.resource.data.email is string && request.resource.data.email.matches('^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$')
        && request.resource.data.message is string && request.resource.data.message.size() >= 10 && request.resource.data.message.size() <= 5000
        && (!('subject' in request.resource.data) || (request.resource.data.subject is string && request.resource.data.subject.size() <= 200))
        && request.resource.data.createdAt == request.time;
    }
  }
}
