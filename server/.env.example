PORT=5000
# Single origin, e.g. http://localhost:5173 or your Vercel URL. Use * for any.
CLIENT_ORIGIN=*

# firebase = read content from Firestore, json = read data/portfolio.json
DATA_SOURCE=firebase

FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
